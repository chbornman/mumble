[Unit]
Description=mumble - local voice dictation daemon
After=sound.target

[Service]
Type=simple
WorkingDirectory=%h/projects/mumble
ExecStart=%h/projects/mumble/.venv/bin/python %h/projects/mumble/whisper_daemon.py --config %h/projects/mumble/config.toml
Restart=always
RestartSec=5
# Backstop against runaway memory (e.g. a stuck recording flag growing the
# capture buffer unboundedly). The in-daemon cap is audio.max_recording_seconds;
# this is the hard ceiling behind it.
MemoryMax=6G

# Wayland environment
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
